[Unit]
Description=TBD isolated Hermes gateway (%i)
PartOf=tbd-pilot.target
After=network-online.target tbd-server.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=tbd
Group=tbd
WorkingDirectory=/opt/tbd/app
Environment=HOME=/var/lib/tbd
Environment=PATH=/opt/tbd/node/bin:/opt/tbd/hermes/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/tbd/%i.env
# Only nonsecret routing goes in this environment file. Hermes loads its own
# profile .env; the platform Stripe, Supabase and root keys are not inherited.
ExecStart=/opt/tbd/hermes/bin/hermes --profile ${HERMES_PROFILE} gateway run --force --external-supervisor --accept-hooks
Restart=always
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tbd

