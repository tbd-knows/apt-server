# Required shared development values. Keep this file server-side and obtain
# real secrets through the team password manager.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
SUPABASE_DATABASE_SSL=true

# Exactly two real Supabase Auth UUIDs; enforced after token verification.
APT_PILOT_USER_IDS=replace-founder-one-uuid,replace-founder-two-uuid
APT_COMMERCE_MODE=test
APT_LIVE_COMMERCE_ENABLED=false

# Optional stable API URL reachable by both phones. Metro is a separate tunnel.
# APT_MOBILE_API_URL=https://api.example.com

HERMES_KEY_SECRET=replace-with-at-least-32-random-characters
HERMES_HOME=.hermes
HERMES_MODEL=gpt-5.6-luna
HERMES_PROVIDER_API_KEY=replace_me

# Local-only Apt bridge. Keep this endpoint private; Hermes receives
# a profile-bound HMAC bridge token during provisioning.
APT_INTERNAL_URL=http://127.0.0.1:8787
# Optional exact private container IPs allowed to call the bridge. Never proxy /internal.
APT_INTERNAL_PEER_IPS=
# Hermes A2A uses separately derived per-peer credentials; no extra user setup.
# Override for host processes; local:phone populates a port per profile.
# HERMES_A2A_PROFILE_URL_MAP={"apt-opaque-profile":"http://127.0.0.1:9900"}

# Commerce providers are optional for engineering; missing values fail closed.
# Set keys/account maps for ONE mode only. Live additionally requires the gate above.
APT_PUBLIC_URL=
APT_PHOTO_BUCKET=pilot-photos
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECTED_ACCOUNTS={}
STRIPE_WEBHOOK_SECRET=
EASYPOST_API_KEY=
EASYPOST_USER_ID=
EASYPOST_CARRIER_ACCOUNT_ID=
EASYPOST_WEBHOOK_SECRET=
APT_SHIPPING_CARRIER=FedEx
APT_SHIPPING_SERVICE=FEDEX_GROUND
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Integer USD cents and founder-confirmed explanations shown in every offer.
APT_PILOT_TAX_MINOR=0
APT_PILOT_TAX_TREATMENT=
APT_PILOT_FEE_SUBSIDY=

# Runtime, routing, pinned-version, provider, port, and local-stack values have
# code defaults. See docs/local-phone-stack.md only when an override is needed.
