# Required shared development values. Keep this file server-side and obtain
# real secrets through the team password manager.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SUPABASE_DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres
SUPABASE_DATABASE_SSL=true

HERMES_KEY_SECRET=replace-with-at-least-32-random-characters
HERMES_HOME=.hermes
HERMES_MODEL=gpt-5.6-luna
HERMES_PROVIDER_API_KEY=replace_me

# Local-only Apt bridge. Keep this loopback/LAN endpoint private; Hermes receives
# a profile-bound HMAC bridge token during provisioning.
APT_INTERNAL_URL=http://127.0.0.1:8787

# Runtime, routing, pinned-version, provider, port, and local-stack values have
# code defaults. See docs/local-phone-stack.md only when an override is needed.
